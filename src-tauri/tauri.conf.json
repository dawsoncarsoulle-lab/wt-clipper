{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WT Clipper",
  "version": "0.2.4",
  "identifier": "dev.wtclipper",
  "build": {
    "beforeDevCommand": "npm --prefix frontend run dev -- --host 127.0.0.1",
    "beforeBuildCommand": "npm --prefix frontend run build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "WT Clipper",
        "width": 1240,
        "height": 780,
        "minWidth": 1000,
        "minHeight": 650,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["$HOME/**", "/tmp/**"],
          "requireLiteralLeadingDot": false
        }
      },
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["deb", "rpm"],
    "icon": ["icons/icon.png", "icons/icon.ico", "icons/icon.icns"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI5OEQ4MTk2RjNFRjE2QzgKUldUSUZ1L3psb0dOS2IrYUxubk55N2R4QjFNc0RDb3lNYlF1NXROdTdGVDJZZEpZMlNxS3h4Yy8K",
      "endpoints": [
        "https://github.com/dawsoncarsoulle-lab/wt-clipper/releases/latest/download/latest.json"
      ]
    }
  }
}
